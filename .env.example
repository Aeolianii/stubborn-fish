# 火山方舟 API Key。只配置在后端，禁止写入 Canvas 前端。
ARK_API_KEY=your-ark-api-key

# 火山方舟图片生成 API。
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 填写控制台实际开通的 Model ID 或 Endpoint ID。
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# 单次 AI 请求超时，单位毫秒。
SEEDREAM_TIMEOUT_MS=120000

# 开发期图生文目标定位：返回 bbox、中心点和粗轮廓。
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628
ARK_VISION_TIMEOUT_MS=120000

# 开发期故事生成代理；比赛接入时由 Canvas 侧切回 tt 调用。
ARK_STORY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_STORY_MODEL=doubao-seed-2-1-turbo-260628
ARK_STORY_TIMEOUT_MS=12000

# 本地服务。
HOST=127.0.0.1
PORT=3000

# 抠图结果仅临时保存，默认 30 分钟。
TEMP_STORAGE_DIR=./data/tmp
TEMP_STORAGE_TTL_MINUTES=30

# 单张上传图片大小限制。
MAX_UPLOAD_MB=5
